#
# Runtime image used to customize an alinux3 base qcow2 into a Pod VM image.
#
# Uses Ubuntu for libguestfs/virt-customize reliability. The guest rootfs being
# customized is still the alinux3 qcow2 from Koji; only the host-side tools run
# in this container.
#
# Run with --privileged and volume mounts for:
#   - input base qcow2
#   - Pod VM overlay (etc/, usr/, pause_bundle/)
#   - output directory
#

FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive
ARG http_proxy
ARG https_proxy
ARG no_proxy
ENV http_proxy=${http_proxy} \
    https_proxy=${https_proxy} \
    no_proxy=${no_proxy} \
    HTTP_PROXY=${http_proxy} \
    HTTPS_PROXY=${https_proxy} \
    NO_PROXY=${no_proxy}

# linux-image-virtual provides a kernel for the libguestfs/supermin appliance.
# Without it, virt-customize fails inside Docker with "supermin exited with error status 1".
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libguestfs-tools \
        qemu-utils \
        linux-image-virtual \
        ca-certificates \
        curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# libguestfs in a container needs the direct backend and a privileged run.
ENV LIBGUESTFS_BACKEND=direct
ENV LIBGUESTFS_DEBUG=0
ENV LIBGUESTFS_TRACE=0

WORKDIR /work
COPY hack/customize-alinux3-image.sh /work/customize-alinux3-image.sh
RUN chmod +x /work/customize-alinux3-image.sh

ENTRYPOINT ["/work/customize-alinux3-image.sh"]
